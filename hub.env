# Cała konfiguracja aplikacji w jednym pliku. Zmiany wchodzą po: sudo systemctl restart hub
# VOTE_SECRET zostanie wygenerowany i dopisany tu automatycznie przy pierwszym starcie.
# Nie zmieniaj go później i nie publikuj, inaczej głosy przestaną pasować do osób.

ROOT_PATH=/hub
VOTE_THRESHOLD=3

# --- Ollama: lokalny daemon (https://docs.ollama.com/cloud) ---
# LLM idzie na lokalnego daemonaczy - model gpt-oss:20b-cloud jest juz ciagniety
# i dziala po `ollama signin` (chmura obslugiwana przez lokalny serwer, bez klucza API).
# OLLAMA_API_KEY potrzebny tylko przy bezposrednim API https://ollama.com (puste = nieuzywany).
# Gdy daemon nie dziala, aplikacja przechodzi w tryb offline (slowniki zamiast AI).
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=
LLM_MODEL=gpt-oss:20b-cloud
EMB_MODEL=bge-m3
# Embeddingi moga isc na osobnym hoście (np. lokalny daemon z modelem bge-m3):
EMB_URL=http://localhost:11434

VOTE_SECRET=5b1350863b38e580aa7571191ff45fd538b7f72874ceaab187316f81049f7eba
