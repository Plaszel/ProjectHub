# /etc/systemd/system/hub.service  (zmień User i ścieżki na swoje)
[Unit]
Description=Hub Innowacji Spolecznych
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ProjectHub
ExecStart=/home/ubuntu/ProjectHub/venv/bin/uvicorn main:app --host 127.0.0.1 --port 3000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always

[Install]
WantedBy=multi-user.target
